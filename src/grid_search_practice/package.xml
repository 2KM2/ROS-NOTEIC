<?xml version="1.0"?>
<package format="2">
  <name>grid_search_practice</name>
  <version>0.1.0</version>
  <description>
    40x40 栅格练习包：BFS / DFS / Dijkstra / A* 四个独立函数留给你写。
    地图、邻居、代价、启发函数和 RViz 单步回放已经写好。
  </description>
  <maintainer email="kaiming.zhang@example.com">kaiming.zhang</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>astar_tutorial</depend>

  <exec_depend>rviz</exec_depend>
</package>
