<?xml version="1.0"?>
<package format="2">
  <name>astar_tutorial</name>
  <version>0.1.0</version>
  <description>
    从零手写的 A* 栅格路径搜索，带 rviz 单步可视化。
    算法核心（include/astar_tutorial/astar.h + src/astar.cpp）只依赖 STL，
    逐行注释对应 A* 的标准伪代码，可脱离 ROS 单独编译。
  </description>
  <maintainer email="kaiming.zhang@example.com">kaiming.zhang</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>
