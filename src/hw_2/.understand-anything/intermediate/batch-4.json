      "complexity": "moderate"
    },
    {
      "id": "file:src/waypoint_generator/src/waypoint_generator.cpp",
      "type": "file",
      "name": "waypoint_generator.cpp",
      "filePath": "src/waypoint_generator/src/waypoint_generator.cpp",
      "summary": "ROS 节点入口：将 RViz 3D Nav Goal（/goal）按 waypoint_type 转为 nav_msgs/Path，发布 waypoints 供 demo_node 规划；作业中常用 manual-lonely-waypoint。",
      "tags": ["入口点", "ros-node", "回调", "航点"],
      "complexity": "complex",
      "languageNotes": "以 waypoint_type 在 circle/eight/point/series/manual-lonely-waypoint 等模式间分支；series 模式按时间戳分段发布。"
    },
    {
      "id": "function:src/waypoint_generator/src/waypoint_generator.cpp:load_seg",
      "type": "function",
      "name": "load_seg",
      "filePath": "src/waypoint_generator/src/waypoint_generator.cpp",
      "lineRange": [30, 71],
      "summary": "从参数服务器读取某一航点段的 x/y/z/yaw，相对当前 odom 做二维旋转平移后压入分段队列。",
      "tags": ["航点", "参数加载", "坐标变换"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/waypoint_generator/src/waypoint_generator.cpp:load_waypoints",
