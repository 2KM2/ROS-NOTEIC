<launch>
  <!-- Keep the defaults compatible with the supplied laser.bag. -->
  <arg name="use_sim_time" default="true"
       doc="Use true for rosbag play --clock; use false for live sensor data."/>
  <arg name="start_rviz" default="true"
       doc="Set false for headless builds, tests, or topic-only debugging."/>
  <arg name="scan_topic" default="champion_scan"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="laser_frame" default="base_laser"/>
  <arg name="tf_timeout_sec" default="0.5"/>
  <arg name="motion_segment_sec" default="0.005"/>

  <!-- ICP surrounding infrastructure parameters.  PclIcpEstimator remains the
       only registration solver TODO; these defaults configure validation,
       filtering, odom priors, and acceptance gates around it. -->
  <arg name="voxel_leaf_size" default="0.05"/>
  <arg name="minimum_icp_points" default="30"/>
  <arg name="minimum_icp_correspondences" default="0"/>
  <arg name="maximum_icp_fitness" default="0.10"/>
  <arg name="maximum_translation_correction" default="0.50"/>
  <arg name="maximum_yaw_correction_degrees" default="30.0"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <node name="LaserUndistortion_Node"
        pkg="LaserUndistortion"
        type="LaserUndistortion_node"
        output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="laser_frame" value="$(arg laser_frame)"/>
    <param name="tf_timeout_sec" value="$(arg tf_timeout_sec)"/>
    <param name="motion_segment_sec" value="$(arg motion_segment_sec)"/>

    <param name="icp/voxel_leaf_size" value="$(arg voxel_leaf_size)"/>
    <param name="icp/minimum_points" value="$(arg minimum_icp_points)"/>
    <param name="icp/minimum_correspondences"
           value="$(arg minimum_icp_correspondences)"/>
    <param name="icp/maximum_fitness" value="$(arg maximum_icp_fitness)"/>
    <param name="icp/maximum_translation_correction"
           value="$(arg maximum_translation_correction)"/>
    <param name="icp/maximum_yaw_correction_degrees"
           value="$(arg maximum_yaw_correction_degrees)"/>
  </node>

  <group if="$(arg start_rviz)">
    <node name="rviz"
          pkg="rviz"
          type="rviz"
          args="-d $(find LaserUndistortion)/launch/LaserMotion.rviz"
          output="screen" />
  </group>
</launch>
