<?xml version="1.0"?>
<package format="2">
  <name>champion_nav_msgs</name>
  <version>1.12.12</version>
  <description>Custom message definitions used by the LaserMotion homework.</description>

  <maintainer email="davidvlu@gmail.com">zq</maintainer>
  <maintainer email="mferguson@fetchrobotics.com">zq</maintainer>
  <license>BSD</license>
  <url type="website">http://wiki.ros.org/move_base_msgs</url>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>message_runtime</build_export_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>message_runtime</exec_depend>
</package>
