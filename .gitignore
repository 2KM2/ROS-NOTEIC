# catkin 产物
build/
devel/
install/
logs/
.catkin_workspace
# catkin_make 生成的 toplevel.cmake 符号链接
src/CMakeLists.txt

# 编译产物,不入库(catkin_make 生成到 devel/lib/)
*.so
*.o
*.a

.codegraph/
.cursor/
.github/
.vscode/
log

# 原始 ROS bag 数据文件体积较大，仅保留在本地或通过外部链接分发。
*.bag

# VS Code 调试配置通常是个人偏好；LaserMotion workspace 的可复现调试配置例外。
.vscode/
